# Template for local-secrets.properties — copy this file, then fill in real values.
#
#   cp local-secrets.properties.example local-secrets.properties
#
# The real file is gitignored and loaded automatically via spring.config.import in
# application.yaml. Never commit real credentials; application.yaml keeps only
# placeholder fallbacks so the app still starts without this file (with those
# integrations non-functional).

# --- Required to start ---
DB_PASSWORD=your-mysql-root-password
# Any long random string. Generate one with: openssl rand -base64 48
JWT_SECRET=replace-with-a-long-random-string

# --- Google sign-in ---
# console.cloud.google.com → APIs & Services → Credentials → OAuth client ID (Web application)
# Authorised redirect URI MUST include the context path:
#   http://localhost:8080/jobTracking/login/oauth2/code/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- GitHub sign-in ---
# github.com/settings/developers → OAuth Apps → New OAuth App
# Authorization callback URL:
#   http://localhost:8080/jobTracking/login/oauth2/code/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- Email (password reset + follow-up reminders) ---
# GMAIL_APP_PASSWORD is a Google App Password, NOT the account password:
# myaccount.google.com/apppasswords (requires 2-Step Verification enabled).
# 16 lowercase letters — strip the spaces Google displays.
GMAIL_USER=
GMAIL_APP_PASSWORD=

# --- File upload ---
# cloudinary.com dashboard. CLOUD_NAME is the slug after the '@' in the
# CLOUDINARY_URL shown there — it is not the API key name.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Phase 2, unused today ---
GEMINI_API_KEY=
